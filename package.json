{
  "name": "gtaa-ops-console",
  "version": "0.1.0",
  "private": true,
  "description": "GTAA Ops Console — decision-support console for airport operations (demo)",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "contracts:openapi": "pnpm --filter @gtaa/contracts openapi",
    "seed": "pnpm --filter @gtaa/api seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
