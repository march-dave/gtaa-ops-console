# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# CORS
WEB_ORIGIN=http://localhost:5173

# Auth mode: "mock" (local dev) or "entra" (Azure AD / Entra ID)
AUTH_MODE=mock

# When AUTH_MODE=entra, validate tokens issued by this tenant + app
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=

# Power BI embed (placeholder — real impl needs service principal + workspace permissions)
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=
