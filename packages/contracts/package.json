{
  "name": "@gtaa/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared API contracts (Zod schemas + TypeScript types) for GTAA Ops Console",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi": "./src/openapi.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "openapi3-ts": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
